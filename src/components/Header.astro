---
import { site } from "../data/site";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
  { href: "/work", label: "Work" },
  { href: "/blog", label: "Writing" },
  { href: "/about", label: "About" },
];
const isActive = (href: string) => path === href || path.startsWith(href + "/");
---

<header class="site-header" transition:persist>
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label={`${site.name}, home`}>
      <span class="mark" aria-hidden="true">AC</span>
      <span class="name">{site.name}</span>
    </a>
    <nav class="site-nav" aria-label="Site">
      {nav.map((n) => (
        <a href={n.href} aria-current={isActive(n.href) ? "page" : undefined}>{n.label}</a>
      ))}
      <a class="icon" href={site.github} rel="me noopener" aria-label="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .5A11.5 11.5 0 0 0 8.36 22.9c.58.1.79-.25.79-.56v-2.1c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
      </a>
      <button class="icon theme" type="button" data-theme-toggle aria-label="Theme">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 3.5v17A8.5 8.5 0 0 0 12 3.5Z" fill="currentColor"/></svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 40; background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 68px; }
  .wordmark { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 700; letter-spacing: -0.01em; }
  .mark { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; background: var(--ink); color: var(--bg); font-family: var(--mono); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.02em; transition: transform 0.3s var(--ease), background 0.2s var(--ease); }
  .wordmark:hover .mark { background: var(--ember); color: #fff; transform: rotate(-6deg); }
  .name { font-size: 1.02rem; }
  .site-nav { display: flex; align-items: center; gap: 4px; }
  .site-nav a:not(.icon) { padding: 8px 12px; border-radius: 999px; text-decoration: none; color: var(--ink-2); font-weight: 600; font-size: 0.95rem; transition: background 0.2s var(--ease), color 0.2s var(--ease); }
  .site-nav a:not(.icon):hover { color: var(--ink); background: var(--bg-2); }
  .site-nav a[aria-current="page"] { color: var(--ink); background: var(--bg-2); }
  .icon { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 999px; color: var(--ink-2); border: 0; background: transparent; cursor: pointer; margin-left: 2px; transition: background 0.2s var(--ease), color 0.2s var(--ease); }
  .icon:hover { color: var(--ink); background: var(--bg-2); }
  .icon svg { width: 19px; height: 19px; }
  .theme[data-state="light"] svg path { opacity: 0.35; }
  @media (max-width: 480px) { .name { display: none; } .site-nav a:not(.icon) { padding: 8px 10px; font-size: 0.92rem; } }
</style>
