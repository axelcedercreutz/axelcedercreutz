---
/**
 * The hero's "player card": a scoreboard-style card with verified numbers.
 * Tilts with the pointer (see Base.astro), sits still under reduced motion.
 */
import { site } from "../data/site";
---

<aside class="hero-card" data-tilt aria-label="At a glance">
  <div class="stripe" aria-hidden="true"></div>
  <div class="top">
    <span class="no mono">AC</span>
    <span class="season mono">Season 2026</span>
  </div>
  <p class="name">Cedercreutz</p>
  <p class="pos">Product engineer · full stack, data, infra</p>
  <dl class="stats">
    <div><dt>Now · product engineer</dt><dd>{site.employer.name}</dd></div>
    <div><dt>Before · five years</dt><dd>{site.previous.name}</dd></div>
    <div><dt>Building since</dt><dd><span data-count="2016">2016</span></dd></div>
    <div><dt>Based in</dt><dd>Helsinki</dd></div>
    <div><dt>Side projects live</dt><dd><span data-count="3">3</span></dd></div>
    <div><dt>Former life</dt><dd>F-liiga floorball</dd></div>
  </dl>
  <div class="foot mono">
    <span><i class="live" aria-hidden="true"></i>On shift · Helsinki</span>
    <span>{site.url.replace("https://", "")}</span>
  </div>
  <span class="sticker" aria-hidden="true">No handoffs</span>
</aside>

<style>
  .hero-card { position: relative; width: min(100%, 400px); background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 24px 24px 20px; box-shadow: var(--shadow); overflow: visible; }
  .stripe { position: absolute; inset: 0 0 auto 0; height: 10px; border-radius: 20px 20px 0 0; background: linear-gradient(90deg, var(--ember) 0 55%, var(--ice) 55% 85%, var(--lime) 85%); }
  .top { display: flex; justify-content: space-between; align-items: center; margin-top: 6px; }
  .no { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 12px; background: var(--ink); color: var(--bg); font-weight: 700; font-size: 0.9rem; letter-spacing: 0.04em; }
  .season { font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3); }
  .name { margin: 18px 0 2px; font-size: clamp(2rem, 3.4vw, 2.6rem); font-weight: 800; letter-spacing: -0.035em; line-height: 1; }
  .pos { margin: 0 0 18px; color: var(--ink-2); font-size: 0.95rem; }
  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; margin: 0; padding-top: 16px; border-top: 1px solid var(--line); }
  .stats div { display: grid; gap: 2px; }
  .stats dt { font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); }
  .stats dd { margin: 0; font-weight: 700; font-size: 1.25rem; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; line-height: 1.1; }
  .stats dd span { color: var(--ember-ink); }
  .foot { display: flex; justify-content: space-between; gap: 12px; margin-top: 18px; padding-top: 12px; border-top: 1px solid var(--line); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); }
  .foot span { display: inline-flex; align-items: center; gap: 7px; }
  .live { position: relative; width: 8px; height: 8px; border-radius: 999px; background: var(--moss); }
  .live::after { content: ""; position: absolute; inset: 0; border-radius: 999px; background: var(--moss); opacity: 0; }
  .sticker { position: absolute; top: -12px; right: -14px; padding: 7px 12px; border-radius: 999px; background: var(--lime); color: #15171b; font-family: var(--mono); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; transform: rotate(6deg); box-shadow: 0 6px 16px -8px rgb(0 0 0 / 0.4); }
  @media (prefers-reduced-motion: no-preference) {
    .hero-card { transform: rotate(-2.5deg); }
    .hero-card.is-tilting { transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) rotate(-2.5deg) translateY(-4px); }
    .live::after { animation: pulse 2.2s ease-out infinite; }
    @keyframes pulse { 0% { transform: scale(1); opacity: 0.5; } 70% { transform: scale(3.2); opacity: 0; } 100% { transform: scale(3.2); opacity: 0; } }
  }
</style>
