---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import WorkCard from "../../components/WorkCard.astro";
import { absolute, ids } from "../../lib/seo";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const jsonLd = {
  "@type": "CollectionPage",
  name: "Work",
  url: absolute(Astro, "/work"),
  isPartOf: { "@id": ids(Astro).website },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: work.map((w, i) => ({ "@type": "ListItem", position: i + 1, name: w.data.title, url: absolute(Astro, `/work/${w.id}`) })),
  },
};
---

<Base title="Work" description="Case studies: RinkView, Banger Board and Budgy. Three products designed, built, shipped and run end to end by Axel Cedercreutz." path="/work" jsonLd={jsonLd}>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Work</p>
        <h1 class="h">Case studies</h1>
        <p>Three products, each one owned end to end. Every number on these pages was checked against the repository it came from; anything I could not verify is marked as pending rather than guessed.</p>
      </div>
      <div class="work-grid">
        {work.map((entry, i) => <WorkCard entry={entry} index={i} featured={i === 0} headingLevel="h2" />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .h { font-size: clamp(2.4rem, 5.5vw, 4.4rem); }
  .work-grid { display: grid; gap: 18px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 900px) { .work-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .work-grid > :global(.featured) { grid-column: 1 / -1; } }
</style>
