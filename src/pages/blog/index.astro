---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";

const posts = (await getCollection("blog", ({ data }) => (import.meta.env.PROD ? !data.draft : true)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title="Writing" description="Notes from the build: short, specific posts by Axel Cedercreutz about how things were made and what went sideways." path="/blog">
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="row">
          <p class="eyebrow">Writing</p>
          <a class="rss" href="/rss.xml">RSS feed</a>
        </div>
        <h1 class="h">Notes from the build.</h1>
        <p>Short, specific posts about how things were made and what went sideways. Product engineering, data, the occasional rink.</p>
      </div>
      <PostList posts={posts} />
    </div>
  </section>
</Base>

<style>
  .h { font-size: clamp(2.4rem, 5.5vw, 4.4rem); }
  .rss { font-weight: 600; text-decoration: none; color: var(--ink-2); }
  .rss:hover { color: var(--ember-ink); }
</style>
